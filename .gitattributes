# Windows batch scripts must be CRLF (read by GBK-encoded cmd.exe on Chinese Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Cross-platform text: LF
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.cfg    text eol=lf
*.example text eol=lf
LICENSE  text eol=lf
